# ── ANTI RADAR configuration ────────────────────────────────────────────────
# Everything is optional. With nothing set, RADAR runs in demo mode on the
# committed real-data snapshot + clearly-labeled fictional examples.

# LLM (Anthropic first; OpenAI optional; "none" = deterministic templates only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_FAST_MODEL=claude-haiku-4-5        # classification, extraction
# LLM_STANDARD_MODEL=claude-sonnet-5-5   # summaries, morning brief
# LLM_DEEP_MODEL=claude-opus-5-5         # RADAR ANALYST investigations, memos

# GitHub (strongly recommended: 5000 req/hr vs 60 unauthenticated).
# On a dev machine with the gh CLI logged in, RADAR falls back to `gh auth token`.
GITHUB_TOKEN=

# X / Twitter official API. Without it X runs in Disabled / Manual mode.
X_BEARER_TOKEN=

# Include fictional demo entities in feeds (always labeled DEMO DATA)
DEMO_MODE=true
