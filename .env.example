# ── ANTI RADAR configuration ────────────────────────────────────────────────
# Copy to .env (never commit it). Everything has a development default; hosted environments are
# validated at startup (python -m radar.config_check) and refuse to start with localhost defaults.
#
#   development  local machine (default)          make dev / make up
#   demo         public verified-snapshot backend Render "radar-demo"
#   production   live backend                     Render "radar-live" + GitHub Actions cron
#
# See docs/DEPLOYMENT.md for the full production setup.

# ── Environment ─────────────────────────────────────────────────────────────
# development | demo | production
APP_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Runtime URL. On Neon use the POOLED host (…-pooler…) with ?sslmode=require.
# postgres:// and postgresql:// URLs are accepted (rewritten to the psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# Direct (non-pooled) URL used by Alembic migrations. Optional; defaults to DATABASE_URL.
DATABASE_URL_DIRECT=
# SQLAlchemy pool per process. Neon free: DB_POOL_SIZE=3 DB_MAX_OVERFLOW=2.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# One-shot CLI jobs (GitHub Actions): hold no idle connections.
# RADAR_NULLPOOL=1

# Thesis config. The Docker image bakes config/ in at /app/config (default works in-image).
# THESIS_PATH=/app/config/anti_fund_thesis.yaml

# ── Web / security ──────────────────────────────────────────────────────────
# Comma-separated extra CORS origins (development).
CORS_ORIGINS=http://localhost:3000
# The deployed frontend (https in demo/production; added to CORS automatically).
FRONTEND_URL=
# When set, every non-GET API request needs header X-Radar-Admin: <token> (403 {"detail":"read_only"}).
# REQUIRED in production (16+ chars; e.g. `openssl rand -hex 24`). The frontend's /unlock page stores it in
# an httpOnly cookie and the proxy forwards it. Optional for demo; unset in development = writes open.
ADMIN_TOKEN=
# Local production-parity runs only (docker on localhost): downgrade localhost/https checks to warnings.
# ALLOW_LOCAL_PRODUCTION=false

# ── Datasets ────────────────────────────────────────────────────────────────
# Include the clearly-labeled fictional SYNTHETIC dataset in feeds (legacy name: DEMO_MODE). Default false.
DEMO_SYNTHETIC=false
# This backend serves the committed verified real-data snapshot; the clock stays pinned to its as-of date.
DEMO_SNAPSHOT=false
# Seed on container start (backend/start.sh): snapshot = load the verified snapshot if the DB is EMPTY; none.
# SEED_ON_START=none
# Pin "today" (ISO date) for tests and scripted demos.
# TODAY_OVERRIDE=

# ── LLM (Anthropic first; OpenAI optional; "none" = deterministic templates + cached text) ────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_FAST_MODEL=claude-haiku-4-5        # classification, extraction
# LLM_STANDARD_MODEL=claude-sonnet-5-5   # summaries, morning brief
# LLM_DEEP_MODEL=claude-opus-5-5         # RADAR ANALYST investigations, memos
# Global live-spend cap per UTC day (USD); 0 disables the cap.
# LLM_DAILY_USD_CAP=10
# LLM_MAX_USD_PER_INVESTIGATION=1.50

# ── Sources ─────────────────────────────────────────────────────────────────
# GitHub (strongly recommended: 5,000 req/h vs 60 unauthenticated). RADAR_GITHUB_TOKEN wins over
# GITHUB_TOKEN (GitHub Actions forbids secrets named GITHUB_*). Use a fine-grained, read-only token.
# In development only, RADAR falls back to `gh auth token`.
RADAR_GITHUB_TOKEN=
GITHUB_TOKEN=
# X / Twitter official API v2. Without it X is DISABLED ("API access not configured"); manual paste still works.
X_BEARER_TOKEN=
# HTTP_USER_AGENT="AntiRadar/0.1 (+https://github.com/anti-radar; research crawler)"

# ── Container / Render ──────────────────────────────────────────────────────
# PORT=8000              # uvicorn port (Render sets it)
# WEB_CONCURRENCY=1      # uvicorn workers (Render free: 512 MB → 1)

# ── Frontend (frontend/.env.local or Vercel project env; server-only, never NEXT_PUBLIC_) ─────────────
# BACKEND_URL=http://localhost:8000          # live backend (must be https in production)
# DEMO_BACKEND_URL=                          # verified-snapshot backend (radar_dataset=demo cookie)

# ── docker compose ──────────────────────────────────────────────────────────
# EXTRA_CA_CERT=/path/to/corporate-ca.crt    # optional CA bundle for TLS-intercepting networks (build secret)
# API_PORT=8000  WEB_PORT=3000  DB_PORT=5432

# Per-visitor rate limits behind the Next.js proxy (set true when the API is only reached via the proxy)
TRUST_PROXY_CLIENT_IP=false

# ── One-command deploy (scripts/deploy.py, `make deploy`; see docs/DEPLOYMENT.md) ───────────────────────
# Read only by the deploy script, never by the app. `make deploy-check` says where to create each one.
# NEON_API_KEY=
# RENDER_API_KEY=
# VERCEL_TOKEN=
# Optional: NEON_ORG_ID= RENDER_OWNER_ID= VERCEL_TEAM_ID=
# Generated on first deploy; the admin token of radar-live (paste at /unlock). Not ADMIN_TOKEN, which would
# make the local stack read-only.
# PROD_ADMIN_TOKEN=
